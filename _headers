# Cache-Control headers for static assets
# https://developers.cloudflare.com/cache about/cache-rules

# Static assets - cache for 1 year (immutable, content-hashed)
/src/*.css
/src/*.js
/images/*
/src/images/*
  Cache-Control: public, max-age=31536000, immutable

# HTML files - cache for 1 hour, revalidate
/*.html
/blog/*.html
/tools/*.html
  Cache-Control: public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400

# Root pages - shorter cache
/robots.txt
/sitemap.xml
  Cache-Control: public, max-age=86400

# WebP images - cache for 1 year
/*.webp
  Cache-Control: public, max-age=31536000, immutable

# SVG files - cache for 1 year
/*.svg
  Cache-Control: public, max-age=31536000, immutable

# Root files
/favicon.ico
/logo.svg
  Cache-Control: public, max-age=86400

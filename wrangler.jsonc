{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "main",
  "main": "src/index.mjs",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}

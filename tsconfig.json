{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./modules",
    "rootDir": "./modules-ts",
    "lib": ["ES2020", "DOM"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["modules-ts/**/*"],
  "exclude": ["node_modules", "modules"]
}